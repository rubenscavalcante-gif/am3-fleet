# AM3 Fleet - exemplo de variáveis para produção
# Copiar para o ambiente do servidor. Não versionar o arquivo real com senhas.

NODE_ENV=production
PORT=4175
HOST=0.0.0.0
APP_TIME_ZONE=America/Sao_Paulo

# Banco Postgres recomendado
DB_TYPE=postgres
DB_HOST=host-do-postgres
DB_PORT=5432
DB_DATABASE=am3_fleet
DB_USER=am3_fleet_app
DB_PASSWORD=trocar_por_senha_forte
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Pool
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# Storage local ou supabase
STORAGE_DRIVER=local

# Se usar Supabase Storage:
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=trocar_por_service_role_key
# SUPABASE_STORAGE_BUCKET=am3-fleet

# Discord opcional
DISCORD_WEBHOOK_URL=

# Backups
FLEETDESK_BACKUP_DIR=backups
